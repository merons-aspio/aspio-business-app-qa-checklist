# Copy this file to .env.local and fill in the values from
# Firebase console -> Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to true to use the local Firebase emulators (npm run emulators).
# Ignored in production builds; emulators only connect during `npm run dev`.
VITE_USE_FIREBASE_EMULATORS=false
# Set to true to force local-only mode (no sign-in, no sync).
VITE_FIREBASE_DISABLED=false

# --- Vercel / production only -------------------------------------------
# The VITE_* values above are inlined at build time. Add the same keys in
# Vercel -> Project -> Settings -> Environment Variables, then redeploy.
#
# Server-only secret for the hosted MCP endpoint (api/mcp.ts). Paste the full
# service-account JSON on one line. Do NOT prefix this with VITE_, otherwise
# it would be bundled into the browser.
FIREBASE_SERVICE_ACCOUNT_JSON=

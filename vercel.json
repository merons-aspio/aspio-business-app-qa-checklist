{
  "framework": "vite",
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "api/mcp.ts", "use": "@vercel/node", "config": { "maxDuration": 10 } }
  ],
  "routes": [
    { "src": "/api/mcp", "dest": "/api/mcp" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
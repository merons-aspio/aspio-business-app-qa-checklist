rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only verified Aspio Google accounts (or explicitly allowed individuals) may read or write QA data.
    function isAspio() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && (
          request.auth.token.get('email', '').lower().matches('.*@aspio[.]se$')
          || request.auth.token.get('email', '').lower() == 'meronsolomondana@gmail.com'
        );
    }

    match /qaRuns/{runId} {
      allow read, write: if isAspio();

      match /{document=**} {
        allow read, write: if isAspio();
      }
    }

    // MCP configuration — readable only by the designated admin account.
    function isMcpAdmin() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '').lower() == 'meron.s@aspio.se';
    }

    match /mcpConfig/{docId} {
      allow read: if isMcpAdmin();
      allow write: if isMcpAdmin();
    }

    match /mcpKeys/{docId} {
      allow read, write: if isMcpAdmin();
    }
  }
}

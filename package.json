{
  "name": "aspio-business-app-qa-checklist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p api/tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules"
  },
  "devDependencies": {
    "@vercel/node": "^3.0.0",
    "autoprefixer": "^10.4.14",
    "firebase-tools": "^15.37.0",
    "postcss": "^8.4.21",
    "tailwindcss": "3.3.2",
    "typescript": "^5.0.2",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "firebase-admin": "^12.0.0"
  }
}
